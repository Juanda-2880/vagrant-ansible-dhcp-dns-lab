$TTL 86400
@   IN  SOA     ns1.{{ dns_domain }}. admin.{{ dns_domain }}. (
        {{ dns_zone_serial }}  ; Serial
        3600        ; Refresh
        1800        ; Retry
        604800      ; Expire
        86400 )     ; Minimum TTL

; Name Servers
@   IN  NS      ns1.{{ dns_domain }}.

; Records
{% for record in dns_records %}
{{ record.host }}   IN  {{ record.type }}   {{ record.data }}
{% endfor %}